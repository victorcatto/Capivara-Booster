<UserControl x:Class="CapivaraBooster.Views.SystemBoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CapivaraBooster.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SystemBoostViewModel}"
             d:DesignHeight="850" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,25,30,30">
            <!-- Header -->
            <TextBlock Text="{Binding Loc[SystemBoost_Title]}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Loc[SystemBoost_Subtitle]}"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20" />

            <!-- HPET Card -->
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Loc[SystemBoost_Hpet_Title]}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#0C2E1B" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HpetStatus}" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Loc[SystemBoost_Hpet_Desc]}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" VerticalAlignment="Center"
                            Content="{Binding Loc[SystemBoost_Hpet_ToggleBtn]}"
                            Style="{StaticResource PrimaryCyberButtonStyle}"
                            Command="{Binding ToggleHpetCommand}" Padding="16,10" />
                </Grid>
            </Border>

            <!-- Ultimate Performance Power Plan Card -->
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Loc[SystemBoost_Power_Title]}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Loc[SystemBoost_Power_Desc]}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ActivePowerPlan, StringFormat='Active: {0}'}" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" VerticalAlignment="Center"
                            Content="{Binding Loc[SystemBoost_Power_Button]}"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding EnableUltimatePowerCommand}" Padding="16,10" />
                </Grid>
            </Border>

            <!-- Global Gaming & Network Tweaks Card -->
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc[SystemBoost_Tweaks_Title]}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Loc[SystemBoost_Tweaks_Desc]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding Loc[SystemBoost_Tweaks_Revert]}" Style="{StaticResource DangerButtonStyle}" Command="{Binding RevertOptimizationsCommand}" Margin="0,0,10,0" Padding="12,8" FontSize="12" />
                            <Button Content="{Binding Loc[SystemBoost_Tweaks_ApplyAll]}" Style="{StaticResource PrimaryCyberButtonStyle}" Command="{Binding ApplyAllOptimizationsCommand}" Padding="16,8" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />

                    <!-- Tweaks details -->
                    <StackPanel>
                        <Border Background="#12141F" CornerRadius="6" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Network Throttling Index (0xFFFFFFFF) &amp; SystemResponsiveness (0)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Disables packet throttling during non-multimedia tasks, removing packet queues and smoothing ping." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1B2233" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Network/DPC" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="#12141F" CornerRadius="6" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Disable Game DVR &amp; Background Capture Hooks" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Eliminates Xbox Game DVR background encoding that steals GPU encoder bandwidth and creates input lag." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1B2233" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Input Latency" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="#12141F" CornerRadius="6" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Disable Fullscreen Optimizations Globally (GameConfigStore)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Prevents DWM compositing layer injection, granting direct exclusive display access." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1B2233" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Display Buffer" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="#12141F" CornerRadius="6" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Disable Windows Background Applications Globally" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Blocks idle UWP applications and search app tasks from waking up and interrupting active gaming threads." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1B2233" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="CPU Threads" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Startup Programs Section -->
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc[SystemBoost_Startup_Title]}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Loc[SystemBoost_Startup_Desc]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding Loc[SystemBoost_Startup_Refresh]}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshStartupItemsCommand}" Padding="12,6" FontSize="12" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding StartupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12141F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1B2233" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Location}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
