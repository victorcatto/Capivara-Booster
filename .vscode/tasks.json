{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Capivara Booster (Debug)",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": ["build", "CapivaraBooster.sln", "-c", "Debug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Capivara Booster (Release)",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": ["build", "CapivaraBooster.sln", "-c", "Release"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish App Binaries",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "publish",
        "src/CapivaraBooster/CapivaraBooster.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-o",
        "./publish/app"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Release: Bump Patch & Push to GitHub",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./publish-update.ps1",
        "-BumpType",
        "patch"
      ],
      "problemMatcher": []
    },
    {
      "label": "Release: Bump Minor & Push to GitHub",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./publish-update.ps1",
        "-BumpType",
        "minor"
      ],
      "problemMatcher": []
    }
  ]
}
