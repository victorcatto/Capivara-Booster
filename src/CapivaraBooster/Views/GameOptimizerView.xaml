<UserControl x:Class="CapivaraBooster.Views.GameOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CapivaraBooster.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:GameOptimizerViewModel}"
             d:DesignHeight="950" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,25,30,30">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Loc[GameOpt_Title]}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Loc[GameOpt_Subtitle]}"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="{Binding Loc[GameOpt_DetectBtn]}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DetectAllGamesCommand}" Padding="14,8" VerticalAlignment="Center" />
            </Grid>

            <!-- Game Sub-Cards Container -->
            <StackPanel>
                <!-- ================= CS2 CARD ================= -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#45270A" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="CS2" FontWeight="Bold" FontSize="13" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Loc[CS2_Card_Title]}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="#1B2233" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Cs2State.InstalledPath, TargetNullValue='Scanning...', FallbackValue='Scanning...'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="350" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Loc[GameOpt_RevertBtn]}" Style="{StaticResource DangerButtonStyle}" Command="{Binding RevertCs2Command}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />
                                <Button Content="{Binding Loc[GameOpt_OptimizeBtn]}" Style="{StaticResource PrimaryCyberButtonStyle}" Command="{Binding OptimizeCs2Command}" Padding="16,8" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />

                        <!-- Tweaks Checklist -->
                        <StackPanel Margin="4,0">
                            <CheckBox Content="{Binding Loc[GameOpt_PriorityLabel]}" IsChecked="True" IsEnabled="False" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[GameOpt_PriorityDesc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[GameOpt_FseLabel]}" IsChecked="True" IsEnabled="False" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[GameOpt_FseDesc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[GameOpt_ShaderLabel]}" IsChecked="{Binding Cs2ClearShaderCache}" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[GameOpt_ShaderDesc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[CS2_Autoexec_Label]}" IsChecked="{Binding Cs2GenerateAutoexec}" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[CS2_Autoexec_Desc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <!-- Recommended Launch Options -->
                            <Border Background="#10121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Loc[CS2_LaunchOptions_Label]}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Cs2LaunchOptions}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding Loc[CS2_Copy_Button]}" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CopyCs2LaunchOptionsCommand}" Padding="10,4" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= VALORANT CARD ================= -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#450A0A" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="VAL" FontWeight="Bold" FontSize="13" Foreground="{StaticResource DangerBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Loc[Val_Card_Title]}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="#1B2233" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ValState.InstalledPath, TargetNullValue='Scanning...', FallbackValue='Scanning...'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="350" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Loc[GameOpt_RevertBtn]}" Style="{StaticResource DangerButtonStyle}" Command="{Binding RevertValorantCommand}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />
                                <Button Content="{Binding Loc[GameOpt_OptimizeBtn]}" Style="{StaticResource PrimaryCyberButtonStyle}" Command="{Binding OptimizeValorantCommand}" Padding="16,8" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />

                        <!-- Tweaks Checklist -->
                        <StackPanel Margin="4,0">
                            <CheckBox Content="{Binding Loc[GameOpt_PriorityLabel]}" IsChecked="True" IsEnabled="False" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[GameOpt_PriorityDesc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[Val_RiotLow_Label]}" IsChecked="{Binding ValLowPriorityClient}" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[Val_RiotLow_Desc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[Val_Logs_Label]}" IsChecked="{Binding ValClearLogs}" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[Val_Logs_Desc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[Val_Defender_Label]}" IsChecked="{Binding ValDefenderExclusions}" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[Val_Defender_Desc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= LEAGUE OF LEGENDS CARD ================= -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0C344D" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="LoL" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryAccentBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Loc[LoL_Card_Title]}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="#1B2233" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LolState.InstalledPath, TargetNullValue='Scanning...', FallbackValue='Scanning...'}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="350" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Loc[GameOpt_RevertBtn]}" Style="{StaticResource DangerButtonStyle}" Command="{Binding RevertLolCommand}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />
                                <Button Content="{Binding Loc[GameOpt_OptimizeBtn]}" Style="{StaticResource PrimaryCyberButtonStyle}" Command="{Binding OptimizeLolCommand}" Padding="16,8" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />

                        <!-- Tweaks Checklist -->
                        <StackPanel Margin="4,0">
                            <CheckBox Content="{Binding Loc[GameOpt_PriorityLabel]}" IsChecked="True" IsEnabled="False" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[GameOpt_PriorityDesc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[LoL_LowSpec_Label]}" IsChecked="{Binding LolLowSpecAndCloseClient}" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[LoL_LowSpec_Desc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[LoL_Logs_Label]}" IsChecked="{Binding LolClearLogs}" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[LoL_Logs_Desc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />

                            <CheckBox Content="{Binding Loc[LoL_Defender_Label]}" IsChecked="{Binding LolDefenderExclusions}" Margin="0,4" />
                            <TextBlock Text="{Binding Loc[LoL_Defender_Desc]}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
