<Window x:Class="CapivaraBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CapivaraBooster.ViewModels"
        xmlns:views="clr-namespace:CapivaraBooster.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CAPIVARA BOOSTER - Windows 10/11 Esports &amp; Low-Latency Tuning Suite"
        Icon="Assets/app.ico"
        Height="870" Width="1280"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebloatViewModel}"><views:DebloatView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanerViewModel}"><views:CleanerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemBoostViewModel}"><views:SystemBoostView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameOptimizerViewModel}"><views:GameOptimizerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}"><views:BackupRestoreView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Split into Left Sidebar and Right Main Viewport -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="265" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Header with Logo -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*" />
                    <!-- System / Admin Status Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header with Capivara Emblem -->
                <Border Grid.Row="0" Margin="14,18,14,18" Background="#181A24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Capivara Logo Image -->
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" ClipToBounds="True" Background="#0F1015" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5">
                            <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Title and Tagline -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Loc[App_Title]}" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource PrimaryAccentBrush}" TextTrimming="None" />
                            <Border Background="#2B1440" CornerRadius="4" Padding="6,2" Margin="0,3,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding AppVersionBadge}" FontSize="9.5" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1" Margin="14,0">
                    <RadioButton Style="{StaticResource NavButtonStyle}" IsChecked="{Binding IsDashboardActive, Mode=TwoWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Loc[Nav_Dashboard]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}" IsChecked="{Binding IsDebloatActive, Mode=TwoWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Debloat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Loc[Nav_Debloat]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}" IsChecked="{Binding IsCleanerActive, Mode=TwoWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Cleaner">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧼" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Loc[Nav_Cleaner]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}" IsChecked="{Binding IsSystemBoostActive, Mode=TwoWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="SystemBoost">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Loc[Nav_SystemBoost]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}" IsChecked="{Binding IsGameOptimizerActive, Mode=TwoWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="GameOptimizer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Loc[Nav_GameOptimizer]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}" IsChecked="{Binding IsBackupRestoreActive, Mode=TwoWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="BackupRestore">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Loc[Nav_BackupRestore]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Footer Elevation Status & Quick Update Check -->
                <StackPanel Grid.Row="2" Margin="14,0,14,18">
                    <Button Content="{Binding Loc[Nav_CheckUpdates]}" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CheckUpdatesCommand}" Margin="0,0,0,10" Padding="8,5" FontSize="11" />

                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="8" Height="8" Background="{StaticResource SuccessBrush}" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Loc[App_AdminStatus]}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Loc[App_RingStatus]}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN VIEWPORT + HEADER & CONSOLE ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Control Header (Language Switcher & Auth Profile) -->
                <RowDefinition Height="Auto" />
                <!-- Update Notification Banner (if available) -->
                <RowDefinition Height="Auto" />
                <!-- Active Content View -->
                <RowDefinition Height="*" />
                <!-- Console Splitter -->
                <RowDefinition Height="Auto" />
                <!-- Real-time Console Log Pane -->
                <RowDefinition Height="200" MinHeight="100" MaxHeight="450" />
            </Grid.RowDefinitions>

            <!-- Top Control Header Bar -->
            <Border Grid.Row="0" Background="#11131B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[App_Subtitle]}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Right Controls: Language Switcher & Auth Profile -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Language Switcher Segmented Control -->
                        <Border Background="#181A24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{Binding Loc[Lang_Portuguese]}" Style="{StaticResource LangToggleStyle}"
                                             IsChecked="{Binding Loc.IsPortuguese, Mode=OneWay}"
                                             Command="{Binding ChangeLanguageCommand}" CommandParameter="pt-BR" />
                                <RadioButton Content="{Binding Loc[Lang_English]}" Style="{StaticResource LangToggleStyle}"
                                             IsChecked="{Binding Loc.IsEnglish, Mode=OneWay}"
                                             Command="{Binding ChangeLanguageCommand}" CommandParameter="en-US" />
                            </StackPanel>
                        </Border>

                        <!-- Auth Profile Button / Indicator -->
                        <!-- If Not Logged In -->
                        <Button Command="{Binding OpenAuthModalCommand}"
                                Padding="12,6" FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Loc[Auth_LoginRegister]}" />
                            </StackPanel>
                        </Button>

                        <!-- If Logged In -->
                        <Border Background="#181A24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👤" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                <!-- Admin / User Badge -->
                                <Border CornerRadius="4" Padding="6,2" Margin="8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource CyberGradientBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                                    <Setter Property="Background" Value="#252A3C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding UserRoleDisplay}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                </Border>

                                <Button Content="{Binding Loc[Auth_Logout]}" Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding LogoutCommand}" Padding="8,3" FontSize="11" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update Notification Banner -->
            <Border Grid.Row="1" Background="#1A2938" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateMessage}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{Binding Loc[Update_Banner_Btn]}" Style="{StaticResource PrimaryCyberButtonStyle}"
                                Command="{Binding ApplyUpdateCommand}" Padding="12,5" FontSize="11" Margin="0,0,8,0" />
                        <Button Content="✕" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DismissUpdateBannerCommand}" Padding="8,4" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active Content View Host (MVVM ContentControl - only one view rendered at a time) -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" Focusable="False" />

            <!-- Grid Splitter -->
            <GridSplitter Grid.Row="3" Height="2" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- Real-Time Console Output Dock -->
            <Border Grid.Row="4" Background="{StaticResource ConsoleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Console Header Bar -->
                    <Border Grid.Row="0" Background="#0C0D13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💻" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Loc[Console_Title]}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Loc[Console_Subtitle]}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Loc[Console_Copy]}" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CopyLogsCommand}" Padding="8,4" FontSize="11" Margin="0,0,8,0" />
                                <Button Content="{Binding Loc[Console_Clear]}" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ClearLogsCommand}" Padding="8,4" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Console Output Scroll Area -->
                    <ListBox Grid.Row="1" x:Name="ConsoleListBox"
                             ItemsSource="{Binding LogItems}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11.5"
                             Padding="14,4,14,16">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,1.5" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedMessage}" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ColorHex}" />
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= AUTHENTICATION MODAL OVERLAY ================= -->
        <Grid Grid.ColumnSpan="2" Background="#90000000"
              Visibility="{Binding IsAuthModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="430" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CyberCardBorderGradient}"
                    BorderThickness="1.5" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CAPIVARA BOOSTER" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryAccentBrush}" />
                            <TextBlock Text="{Binding Loc[Auth_Modal_Subtitle]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CloseAuthModalCommand}" Padding="8,4" FontSize="12" />
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                    <!-- Mode Switcher (Login vs Register) -->
                    <Border Background="#10121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding Loc[Auth_Modal_TabLogin]}"
                                    Command="{Binding SwitchAuthModeCommand}" Margin="2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                                <Setter Property="Foreground" Value="#0F1015" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Content="{Binding Loc[Auth_Modal_TabSignUp]}"
                                    Command="{Binding SwitchAuthModeCommand}" Margin="2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                                <Setter Property="Foreground" Value="#0F1015" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Email Field -->
                    <TextBlock Text="{Binding Loc[Auth_Modal_EmailLabel]}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AuthEmail, UpdateSourceTrigger=PropertyChanged}" Height="36"
                             Background="#10121A" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" Padding="10,6" FontSize="12.5" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Loc[Auth_Modal_AllowedDomains]}"
                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                    <!-- Password Field -->
                    <TextBlock Text="{Binding Loc[Auth_Modal_PasswordLabel]}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AuthPassword, UpdateSourceTrigger=PropertyChanged}" Height="36"
                             Background="#10121A" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" Padding="10,6" FontSize="12.5" Margin="0,0,0,12" />

                    <!-- Error Text -->
                    <TextBlock Text="{Binding AuthErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <!-- Action Buttons -->
                    <!-- Login Button -->
                    <Button Content="{Binding Loc[Auth_Modal_LoginBtn]}"
                            Command="{Binding LoginCommand}" Padding="16,10" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryCyberButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Register Button -->
                    <Button Content="{Binding Loc[Auth_Modal_RegisterBtn]}"
                            Command="{Binding RegisterCommand}" Padding="16,10" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryCyberButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
