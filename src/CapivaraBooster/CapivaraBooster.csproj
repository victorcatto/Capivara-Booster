<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>CapivaraBooster</AssemblyName>
    <RootNamespace>CapivaraBooster</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Capivara Systems Engineering</Authors>
    <Company>Capivara Booster</Company>
    <Product>Capivara Booster Esports Suite</Product>
    <Description>Enterprise-grade Windows 10/11 Debloater, Junk Cleaner, System Latency &amp; Esports Game Optimizer</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
