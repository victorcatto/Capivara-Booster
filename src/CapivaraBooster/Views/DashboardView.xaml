<UserControl x:Class="CapivaraBooster.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CapivaraBooster.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="650" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,25,30,30">
            <!-- Header -->
            <TextBlock Text="{Binding Loc[Dashboard_Title]}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Loc[Dashboard_Subtitle]}"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,24" />

            <!-- Quick Status Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- OS Card -->
                <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[Dashboard_OsCard_Title]}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding OsVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Loc[Dashboard_OsCard_Target]}" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- HPET Status Card -->
                <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[Dashboard_HpetCard_Title]}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding HpetStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Loc[Dashboard_HpetCard_Desc]}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Power Scheme Card -->
                <Border Grid.Column="4" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[Dashboard_PowerCard_Title]}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Ultimate Performance" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryAccentBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Loc[Dashboard_PowerCard_Desc]}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Games Card -->
                <Border Grid.Column="6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[Dashboard_GamesCard_Title]}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding GamesDetectedSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Loc[Dashboard_GamesCard_Desc]}" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 1-Click Master Boost Hero Card with Cyber Gradient Border -->
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CyberCardBorderGradient}" BorderThickness="1.5" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding Loc[Dashboard_QuickBoost_Title]}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock Text="{Binding Loc[Dashboard_QuickBoost_Desc]}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
                    </StackPanel>

                    <!-- Progress Bar -->
                    <ProgressBar Grid.Row="1" Height="6" Value="{Binding BoostProgress}" Maximum="100"
                                 Background="#0D0E15" Foreground="{StaticResource CyberGradientBrush}" BorderThickness="0"
                                 Margin="0,0,0,16" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="{Binding Loc[Dashboard_QuickBoost_Button]}" Style="{StaticResource PrimaryCyberButtonStyle}"
                                Command="{Binding QuickBoostCommand}" Padding="24,12" FontSize="14" />
                        <Button Content="{Binding Loc[Dashboard_Refresh_Button]}" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshDashboardCommand}" Margin="12,0,0,0" Padding="16,12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Safety Guarantee Card -->
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🛡️" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Loc[Dashboard_Safety_Title]}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Loc[Dashboard_Safety_Desc]}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
