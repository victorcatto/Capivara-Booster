<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Capivara Booster Official Color Palette (Cyberpunk Aesthetic) -->
    <!-- Primary Background: Deep Matte Charcoal -->
    <Color x:Key="WindowBgColor">#0F1015</Color>
    <Color x:Key="SidebarBgColor">#12131A</Color>
    <!-- Card / Panel Surface: Dark Slate -->
    <Color x:Key="CardBgColor">#181A22</Color>
    <Color x:Key="CardHoverColor">#202330</Color>
    <Color x:Key="BorderColor">#262A38</Color>
    <Color x:Key="BorderGlowColor">#00E5FF</Color>
    <Color x:Key="ConsoleBgColor">#0A0B10</Color>

    <!-- Primary Accent: Cyan Neon -->
    <Color x:Key="PrimaryAccentColor">#00E5FF</Color>
    <Color x:Key="PrimaryAccentHoverColor">#33EBFF</Color>
    <Color x:Key="PrimaryAccentMutedColor">#006B78</Color>

    <!-- Secondary Accent: Electric Purple -->
    <Color x:Key="SecondaryAccentColor">#9D00FF</Color>
    <Color x:Key="SecondaryAccentHoverColor">#B033FF</Color>

    <!-- Semantic Indicators -->
    <Color x:Key="SuccessColor">#00E676</Color>
    <Color x:Key="WarningColor">#FFB300</Color>
    <Color x:Key="DangerColor">#FF1744</Color>
    <Color x:Key="InfoColor">#00E5FF</Color>

    <!-- Typography Colors -->
    <!-- Primary Text: Crisp Off-White -->
    <Color x:Key="TextPrimaryColor">#F4F4F6</Color>
    <!-- Secondary Text: Muted Cool Gray -->
    <Color x:Key="TextSecondaryColor">#8E92A4</Color>
    <Color x:Key="TextMutedColor">#5E6377</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="{StaticResource BorderGlowColor}" />
    <SolidColorBrush x:Key="ConsoleBgBrush" Color="{StaticResource ConsoleBgColor}" />

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentHoverBrush" Color="{StaticResource SecondaryAccentHoverColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Cyberpunk Linear Gradients (Cyan Neon #00E5FF to Electric Purple #9D00FF) -->
    <LinearGradientBrush x:Key="CyberGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00E5FF" Offset="0.0" />
        <GradientStop Color="#9D00FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyberGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33EBFF" Offset="0.0" />
        <GradientStop Color="#B033FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyberCardBorderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4000E5FF" Offset="0.0" />
        <GradientStop Color="#409D00FF" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
