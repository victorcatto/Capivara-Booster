<UserControl x:Class="CapivaraBooster.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CapivaraBooster.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DebloatViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,25,30,30">
            <!-- Header -->
            <TextBlock Text="{Binding Loc[Debloat_Title]}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Loc[Debloat_Subtitle]}"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20" />

            <!-- Telemetry & Diagnostic Services Card -->
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Loc[Debloat_Telemetry_Title]}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Loc[Debloat_Telemetry_Desc]}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" VerticalAlignment="Center"
                            Content="{Binding Loc[Debloat_Telemetry_DisableBtn]}"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding ToggleTelemetryCommand}" />
                </Grid>
            </Border>

            <!-- UWP Bloatware Checklist Header & Controls -->
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc[Debloat_Uwp_Title]}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Loc[Debloat_Uwp_Desc]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Selection actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding Loc[Debloat_SelectSafe_Button]}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllSafeCommand}" Margin="0,0,8,0" Padding="10,6" FontSize="12" />
                            <Button Content="{Binding Loc[Debloat_DeselectAll_Button]}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeselectAllCommand}" Margin="0,0,12,0" Padding="10,6" FontSize="12" />
                            <Button Content="{Binding Loc[Debloat_RemoveSelected_Button]}" Style="{StaticResource DangerButtonStyle}" Command="{Binding RemoveSelectedCommand}" Padding="16,8" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />

                    <!-- Bloatware Items List -->
                    <ItemsControl ItemsSource="{Binding BloatwareItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12141F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="14,10" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding PackagePattern, StringFormat=' ({0})'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#1B2233" CornerRadius="4" Padding="8,3" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" />
                                        </Border>

                                        <Border Grid.Column="3" Background="#0C2E1B" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="Safe" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
